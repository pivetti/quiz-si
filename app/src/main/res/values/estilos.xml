<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Tema.QuizSI" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/verde</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/azul_escuro</item>
        <item name="android:windowBackground">@color/fundo</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Tema.QuizSI" parent="Base.Tema.QuizSI" />
    <style name="Texto.Corpo" parent="android:style/Widget.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textSize">17sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="Texto.Titulo" parent="Texto.Corpo">
        <item name="android:textColor">@color/azul_escuro</item>
        <item name="android:textSize">34sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingExtra">0dp</item>
    </style>
    <style name="Texto.Rotulo" parent="Texto.Corpo">
        <item name="android:textColor">@color/verde</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <style name="BotaoQuiz" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/altura_toque</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/fundo_botao</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/superficie</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="BotaoQuiz.Secundario">
        <item name="android:background">@drawable/fundo_botao_secundario</item>
        <item name="android:textColor">@color/azul_escuro</item>
    </style>
    <style name="AlternativaQuiz" parent="android:style/Widget.Material.CompoundButton.RadioButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:minHeight">@dimen/altura_toque</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:background">@drawable/fundo_alternativa</item>
        <item name="android:buttonTint">@color/verde</item>
        <item name="android:textColor">@color/azul_escuro</item>
        <item name="android:textSize">17sp</item>
        <item name="android:saveEnabled">false</item>
    </style>
</resources>
