<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/raiz_tela" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/margem_tela">
        <TextView style="@style/Texto.Rotulo" android:text="@string/rotulo_quiz" />
        <TextView android:id="@+id/texto_progresso" style="@style/Texto.Corpo" android:layout_marginTop="@dimen/espaco_grande" android:textColor="@color/azul_escuro" android:textStyle="bold" android:accessibilityLiveRegion="polite" />
        <ProgressBar android:id="@+id/progresso_quiz" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="12dp" android:progressTint="@color/verde" android:progressBackgroundTint="@color/borda" android:importantForAccessibility="no" />
        <TextView android:id="@+id/texto_pergunta" style="@style/Texto.Titulo" android:textSize="25sp" android:layout_marginTop="@dimen/espaco_grande" />
        <TextView style="@style/Texto.Corpo" android:text="@string/orientacao_escolha" android:textSize="14sp" android:layout_marginTop="12dp" />
        <RadioGroup android:id="@+id/grupo_alternativas" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="@dimen/espaco_grande" android:saveEnabled="false">
            <RadioButton android:id="@+id/alternativa_a" style="@style/AlternativaQuiz" />
            <RadioButton android:id="@+id/alternativa_b" style="@style/AlternativaQuiz" />
            <RadioButton android:id="@+id/alternativa_c" style="@style/AlternativaQuiz" />
            <RadioButton android:id="@+id/alternativa_d" style="@style/AlternativaQuiz" />
        </RadioGroup>
        <TextView android:id="@+id/erro_selecao" style="@style/Texto.Corpo" android:text="@string/selecao_obrigatoria" android:textColor="@color/erro" android:visibility="gone" android:accessibilityLiveRegion="polite" android:layout_marginBottom="12dp" />
        <Button android:id="@+id/botao_confirmar" style="@style/BotaoQuiz" android:text="@string/confirmar_resposta" android:layout_marginTop="@dimen/espaco_pequeno" />
        <TextView android:id="@+id/texto_retorno" style="@style/Texto.Corpo" android:layout_marginTop="@dimen/espaco_grande" android:padding="20dp" android:visibility="gone" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/botao_proxima" style="@style/BotaoQuiz" android:text="@string/proxima_pergunta" android:layout_marginTop="@dimen/espaco_medio" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
